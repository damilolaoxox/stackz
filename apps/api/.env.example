# Local defaults: `pnpm dev` loads this file, then apps/api/.env (if present) on top.
# Never put real secrets here.
# In production these live only in Render's environment settings.

PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
TASK_MIN_SECONDS=8

# "memory" runs without Supabase (data is lost on restart). Use "supabase" for real data.
STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CARDS_BUCKET=cards

# Cloudflare's always-pass test secret. Replace with the real secret in Render.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional. The unavatar.io free tier is rate-limited per IP, and in production
# every lookup comes from Render's IP, so a Pro key is recommended before launch.
UNAVATAR_API_KEY=

# Optional. Shared rate limits across API instances (Upstash Redis, REST API).
# Leave empty to count in memory, which is fine on a single Render instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Turns on the /admin review routes used by `pnpm admin`. At least 32 characters,
# e.g. `openssl rand -hex 32`. Leave empty to keep them off.
ADMIN_TOKEN=
