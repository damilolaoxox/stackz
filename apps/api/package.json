{
  "name": "@stackz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.example --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@stackz/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "satori": "^0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
