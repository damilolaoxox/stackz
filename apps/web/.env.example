# Copy to apps/web/.env for local development.
# Everything here ends up in the public bundle, so never put secrets in this file.
# In production these are set as environment variables on the stackz-web static site in Render.

VITE_API_URL=http://localhost:8787

# Cloudflare's always-pass test site key. Replace with the real Turnstile site key in Render.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional. The X account defaults to playstackz.
VITE_X_HANDLE=
VITE_COMMUNITY_URL=
